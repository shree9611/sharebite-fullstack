### Database / Auth
MONGO_URI=mongodb://127.0.0.1:27017/sharebite
JWT_SECRET=replace_with_long_random_string
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173

### Email notifications (optional)
# Set to 1 to enable email notifications. If disabled or SMTP vars are missing,
# the backend will still work and will only create in-app notifications.
EMAIL_NOTIFICATIONS=0

# SMTP settings (example: Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="ShareBite <your_email@gmail.com>"

