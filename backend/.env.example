### Database / Auth
MONGO_URI=mongodb://127.0.0.1:27017/sharebite
JWT_SECRET=replace_with_long_random_string
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173

### Email notifications (optional)
# Email notifications send when SMTP is configured.
# Set to 0 to force-disable email even if SMTP is configured.
EMAIL_NOTIFICATIONS=1

# SMTP settings (example: Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="ShareBite <your_email@gmail.com>"

### SMTP settings (example: SendGrid SMTP)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# EMAIL_FROM="ShareBite <verified_sender@yourdomain.com>"

### Test email endpoint (protect with a token)
# TEST_EMAIL_TOKEN=replace_with_long_random_string
